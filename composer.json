    "type": "wordpress-plugin",
    "description": "The ultimate geolocation and mapping solution for WordPress.",
    "keywords": ["gmw", "geomywp", "GEO my WP"],
    "homepage": "https://geomywp.com/",
    "license": "GPL-3.0+",
    "support": {
        "issues": "https://geomywp.com/support"
    },
    "config": {
        "disable-tls": true,
        "secure-http": false,
        "allow-plugins": {
          "composer/installers": true
        }
    },
    "require": {
        "php": ">=7.4",
        "composer/installers": "~1.0"
    },
    "minimum-stability": "dev"
}
